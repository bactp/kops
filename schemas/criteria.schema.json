{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kops.local/schemas/criteria.schema.json",
  "title": "KOPS Verification Criteria",
  "description": "verify/criteria.yaml \u2014 executable, deterministic checks implementing a scenario's expected_invariants. Never LLM-judged. Script contract: exit 0 = pass, 1 = fail, any other exit/timeout = error; stdout may carry one JSON object {\"evidence\": ...}.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "scenario",
    "criteria"
  ],
  "properties": {
    "apiVersion": {
      "const": "kops/v1alpha1"
    },
    "kind": {
      "const": "Criteria"
    },
    "scenario": {
      "type": "string"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "invariant",
          "required",
          "check"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "invariant": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "phase": {
            "enum": [
              "final",
              "setup-confirm",
              "both"
            ],
            "default": "both"
          },
          "settle": {
            "type": "boolean",
            "default": false,
            "description": "If true, poll until pass or verification.settle.max_wait_seconds."
          },
          "failure_class": {
            "enum": [
              "goal-not-reached",
              "partial-configuration",
              "wrong-target",
              "collateral-damage",
              "constraint-violation",
              "not-persistent",
              "unstable"
            ],
            "description": "Diagnostic label used when this criterion fails."
          },
          "check": {
            "$ref": "#/$defs/check"
          }
        }
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "apiVersion": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "selector": {
          "type": "string",
          "description": "label selector; mutually exclusive with name"
        }
      },
      "oneOf": [
        {
          "required": [
            "name"
          ]
        },
        {
          "required": [
            "selector"
          ]
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "name"
                ]
              },
              {
                "required": [
                  "selector"
                ]
              }
            ]
          }
        }
      ]
    },
    "check": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "resource",
            "expect"
          ],
          "properties": {
            "type": {
              "const": "k8s.exists"
            },
            "resource": {
              "$ref": "#/$defs/ref"
            },
            "expect": {
              "enum": [
                "present",
                "absent"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "resource",
            "jsonpath",
            "op"
          ],
          "properties": {
            "type": {
              "const": "k8s.field"
            },
            "resource": {
              "$ref": "#/$defs/ref"
            },
            "jsonpath": {
              "type": "string"
            },
            "op": {
              "enum": [
                "eq",
                "ne",
                "in",
                "not_in",
                "regex",
                "exists",
                "absent",
                "gte",
                "lte",
                "contains",
                "subset"
              ]
            },
            "value": {},
            "all_items": {
              "type": "boolean",
              "default": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "resource",
            "op",
            "value"
          ],
          "properties": {
            "type": {
              "const": "k8s.count"
            },
            "resource": {
              "$ref": "#/$defs/ref"
            },
            "field_filter": {
              "type": "string"
            },
            "op": {
              "enum": [
                "eq",
                "gte",
                "lte"
              ]
            },
            "value": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "resource",
            "condition",
            "status"
          ],
          "properties": {
            "type": {
              "const": "k8s.condition"
            },
            "resource": {
              "$ref": "#/$defs/ref"
            },
            "condition": {
              "type": "string"
            },
            "status": {
              "enum": [
                "True",
                "False",
                "Unknown"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "resource"
          ],
          "properties": {
            "type": {
              "const": "k8s.rollout_complete"
            },
            "resource": {
              "$ref": "#/$defs/ref"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "service",
            "namespace",
            "min_ready"
          ],
          "properties": {
            "type": {
              "const": "k8s.endpoints"
            },
            "service": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "min_ready": {
              "type": "integer",
              "minimum": 0
            },
            "port": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "as",
            "verb",
            "resource",
            "expect"
          ],
          "properties": {
            "type": {
              "const": "k8s.can_i"
            },
            "as": {
              "type": "string",
              "description": "user or system:serviceaccount:<ns>:<name>"
            },
            "verb": {
              "type": "string"
            },
            "resource": {
              "type": "string"
            },
            "subresource": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "expect": {
              "enum": [
                "allow",
                "deny"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "resource",
            "scope"
          ],
          "properties": {
            "type": {
              "const": "k8s.unchanged"
            },
            "resource": {
              "$ref": "#/$defs/ref"
            },
            "scope": {
              "enum": [
                "spec",
                "spec+metadata.labels",
                "data",
                "jsonpaths"
              ]
            },
            "jsonpaths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "baseline": {
              "const": "post-setup"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "from",
            "url",
            "expect"
          ],
          "properties": {
            "type": {
              "const": "net.http"
            },
            "from": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "namespace"
              ],
              "properties": {
                "namespace": {
                  "type": "string"
                },
                "labels": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "node": {
                  "type": "string"
                },
                "image": {
                  "type": "string",
                  "description": "Pinned by digest; defaults to the runner's probe image."
                }
              }
            },
            "url": {
              "type": "string"
            },
            "expect": {
              "enum": [
                "reachable",
                "blocked"
              ]
            },
            "status": {
              "type": "integer"
            },
            "body_regex": {
              "type": "string"
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "from",
            "host",
            "port",
            "expect"
          ],
          "properties": {
            "type": {
              "const": "net.tcp"
            },
            "from": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "namespace"
              ],
              "properties": {
                "namespace": {
                  "type": "string"
                },
                "labels": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "node": {
                  "type": "string"
                },
                "image": {
                  "type": "string",
                  "description": "Pinned by digest; defaults to the runner's probe image."
                }
              }
            },
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            },
            "expect": {
              "enum": [
                "reachable",
                "blocked"
              ]
            },
            "timeout_seconds": {
              "type": "integer"
            },
            "attempts": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "from",
            "name",
            "expect"
          ],
          "properties": {
            "type": {
              "const": "net.dns"
            },
            "from": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "namespace"
              ],
              "properties": {
                "namespace": {
                  "type": "string"
                },
                "labels": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "node": {
                  "type": "string"
                },
                "image": {
                  "type": "string",
                  "description": "Pinned by digest; defaults to the runner's probe image."
                }
              }
            },
            "name": {
              "type": "string"
            },
            "record": {
              "enum": [
                "A",
                "AAAA",
                "SRV",
                "CNAME"
              ]
            },
            "expect": {
              "enum": [
                "resolves",
                "nxdomain"
              ]
            },
            "answer_regex": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "node",
            "argv"
          ],
          "properties": {
            "type": {
              "const": "node.exec"
            },
            "node": {
              "type": "string"
            },
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "expect_exit": {
              "type": "integer",
              "default": 0
            },
            "stdout_regex": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "node",
            "unit"
          ],
          "properties": {
            "type": {
              "const": "node.systemd"
            },
            "node": {
              "type": "string"
            },
            "unit": {
              "type": "string"
            },
            "active": {
              "type": "boolean"
            },
            "enabled": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "node",
            "path"
          ],
          "properties": {
            "type": {
              "const": "node.file"
            },
            "node": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "exists": {
              "type": "boolean"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "contains_regex": {
              "type": "string"
            },
            "mode": {
              "type": "string",
              "pattern": "^0[0-7]{3}$"
            },
            "unchanged_since": {
              "const": "post-setup"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "location",
            "path"
          ],
          "properties": {
            "type": {
              "const": "artifact"
            },
            "location": {
              "enum": [
                "workstation",
                "node"
              ]
            },
            "node": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "validator": {
              "type": "string",
              "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$",
              "description": "Script run by the verifier (not the agent) to validate the artifact semantically, e.g. etcdutl snapshot status."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "window_seconds",
            "samples",
            "check"
          ],
          "properties": {
            "type": {
              "const": "stability"
            },
            "window_seconds": {
              "type": "integer",
              "minimum": 5,
              "maximum": 300
            },
            "samples": {
              "type": "integer",
              "minimum": 2,
              "maximum": 30
            },
            "check": {
              "$ref": "#/$defs/check"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "path",
            "justification"
          ],
          "properties": {
            "type": {
              "const": "script"
            },
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            },
            "justification": {
              "type": "string",
              "minLength": 10,
              "description": "Why no builtin check suffices (reviewed)."
            }
          }
        }
      ]
    }
  }
}