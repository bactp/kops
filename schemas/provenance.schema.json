{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kops.local/schemas/provenance.schema.json",
  "title": "KOPS Scenario Provenance",
  "description": "metadata/provenance.yaml \u2014 clean-room provenance record. Required for every scenario; reviewed before status=validated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "competency_source",
    "design_references",
    "copied_question",
    "authoring",
    "contamination_review"
  ],
  "properties": {
    "competency_source": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "certification",
          "curriculum_version",
          "domain",
          "competency_id",
          "competency"
        ],
        "properties": {
          "certification": {
            "enum": [
              "CKA",
              "CKAD"
            ]
          },
          "curriculum_version": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "competency_id": {
            "type": "string",
            "pattern": "^(CKA|CKAD)-[A-Z]{3}-[0-9]{2}$"
          },
          "competency": {
            "type": "string",
            "description": "Verbatim public competency text."
          }
        }
      }
    },
    "design_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "used_for",
          "license"
        ],
        "properties": {
          "repository": {
            "type": "string"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "license": {
            "type": "string"
          },
          "used_for": {
            "enum": [
              "problem-family-idea",
              "verification-pattern",
              "environment-pattern",
              "none"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "upstream_docs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "description": "kubernetes.io or other public docs consulted."
    },
    "copied_question": {
      "const": false
    },
    "copied_code": {
      "type": "array",
      "description": "Must be empty unless listed in docs/reuse-register.md.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_repository",
          "source_path",
          "license",
          "reason",
          "modification",
          "attribution"
        ],
        "properties": {
          "source_repository": {
            "type": "string"
          },
          "source_path": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "modification": {
            "type": "string"
          },
          "attribution": {
            "type": "string"
          }
        }
      }
    },
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "authors",
        "date"
      ],
      "properties": {
        "method": {
          "enum": [
            "human-original",
            "human-original-llm-assisted",
            "parametric-variant"
          ]
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "variant_of": {
          "type": "string"
        }
      }
    },
    "contamination_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "date",
        "checks"
      ],
      "properties": {
        "reviewer": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "no_exam_dump_source",
            "no_quarantined_repo_text",
            "fingerprint_scan_clean"
          ],
          "properties": {
            "no_exam_dump_source": {
              "const": true
            },
            "no_quarantined_repo_text": {
              "const": true
            },
            "fingerprint_scan_clean": {
              "const": true
            },
            "max_ngram_overlap": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Max normalized 8-gram overlap of task.md against the reference corpus (tools/contamination-scan)."
            }
          }
        }
      }
    }
  }
}